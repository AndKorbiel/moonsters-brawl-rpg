rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsGame(data) {
      return signedIn() && data.get('userId', '') == request.auth.uid;
    }

    match /games/{gameId} {
      allow get, list: if ownsGame(resource.data);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if ownsGame(resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if ownsGame(resource.data);
    }

    match /high-score/{scoreId} {
      allow get, list: if true;
      allow create: if signedIn();
    }
  }
}
